{
  "name": "transcripts-to-insights",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "AISC Agent Sprint — turns meeting transcripts into structured insight reports.",
  "scripts": {
    "stage-1": "node stage-1/chat.js",
    "stage-2": "node stage-2/workflow.js",
    "stage-3": "node stage-3/orchestrator.js",
    "server": "node server.js",
    "drop-test": "node --input-type=module --eval \"import{copyFileSync}from'node:fs';const dest='transcripts/incoming/test-'+Date.now()+'.txt';copyFileSync('transcripts/sample-transcript.txt',dest);console.log('Dropped:',dest);\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "chokidar": "^4.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "engines": {
    "node": ">=20"
  }
}
